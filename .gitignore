# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Python tooling
__pycache__/

# Generated by build_runner (freezed / json_serializable).
# Not committed: they are derived from lib/domain/models/*.dart and would add
# noise to every model diff. Run `dart run build_runner build` after cloning
# or after touching a model — nothing compiles without them.
*.freezed.dart
*.g.dart

# Test fixtures and the Kotlin golden file are derived from real financial
# data. Anonymised, but the structure, dates and ratios are genuine, and this
# repository is public. Regenerate them locally instead — see
# test/fixtures/README.md.
test/fixtures/*.json
android/app/src/test/resources/
