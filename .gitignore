# Dependencies
node_modules/

# Frontend build output / caches (regenerated by the Docker build)
dist/
.vite/
.turbo/
.cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
venv/
.venv/
.venv-dev/

# Environment / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Application data — never commit.
# Matched by extension rather than by directory: the runtime path defaults are
# relative, so the app writes its data wherever it is launched from, and a
# directory-based pattern only covers the locations we already know about.
*.db
*.db.gz
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.pkl
*.joblib
backup_metadata.json
alerts_config.json
cloud_config.json

# ... and the known data roots wholesale, to catch extensionless files too.
# app/data is where paths.py resolves DATA_DIR when the env var is unset;
# the other two are legacy locations left by cwd-relative defaults.
myfinanceapp/app/data/
myfinanceapp/app/backend/data/
myfinanceapp/data/

# OS / editor
.DS_Store
*.swp
